{
  "name": "recoveryos-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "RecoveryOS: AI-Assisted Payment Recovery Operating System for Razorpay",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist packages/*/dist apps/*/dist",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "npm --workspace=@recoveryos/db run seed",
    "dev:api": "npm --workspace=@recoveryos/api run dev",
    "start:api": "npm --workspace=@recoveryos/api run start"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
